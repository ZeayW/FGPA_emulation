#!/bin/sh

set -eu
install_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
if [ -n "${PYTHONPATH:-}" ]; then
  export PYTHONPATH="${install_root}/lib:${PYTHONPATH}"
else
  export PYTHONPATH="${install_root}/lib"
fi
export EMUFLOW_NATIVE_ROOT="${EMUFLOW_NATIVE_ROOT:-${install_root}}"
export EMUFLOW_OPENPARF_PYTHON="${EMUFLOW_OPENPARF_PYTHON:-@EMUFLOW_OPENPARF_PYTHON@}"
exec "@Python3_EXECUTABLE@" -m emuflow "$@"
