{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schemas/validation-archive-v1.schema.json",
  "title": "EmuFlow checked validation archive v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "run_id",
    "created_at",
    "source",
    "flow",
    "environment",
    "run_configuration",
    "retention_policy",
    "files",
    "validation"
  ],
  "properties": {
    "schema": {"const": "emuflow.validation-archive/v1"},
    "status": {"const": "pass"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["flow_root", "flow_report", "revision", "external_inputs", "pruned_artifacts"],
      "properties": {
        "flow_root": {"type": "string", "minLength": 1},
        "flow_report": {"const": "multi-fpga-flow-report.json"},
        "revision": {
          "type": "object",
          "required": ["commit", "dirty"],
          "properties": {
            "commit": {"type": ["string", "null"]},
            "dirty": {"type": ["boolean", "null"]}
          },
          "additionalProperties": false
        },
        "external_inputs": {"type": "array", "items": {"type": "object"}},
        "pruned_artifacts": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "required": ["schema", "provider", "summary"],
      "properties": {
        "schema": {"const": "emuflow.multi-fpga-flow/v2"},
        "provider": {"type": "string", "minLength": 1},
        "summary": {"type": "object"}
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["emuflow_version", "python", "platform", "tools"],
      "properties": {
        "emuflow_version": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "tools": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "run_configuration": {"type": "object"},
    "retention_policy": {"type": "object"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_path", "retention", "archive_path", "bytes", "sha256", "roles"],
        "properties": {
          "source_path": {"type": "string", "minLength": 1},
          "retention": {"enum": ["copied", "hash-only"]},
          "archive_path": {"type": ["string", "null"]},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "validation": {"type": "object"}
  },
  "additionalProperties": false
}
