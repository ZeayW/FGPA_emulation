{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/vivado-pin-site-map-v2.schema.json",
  "title": "EmuFlow Vivado package-pin to GT channel/common site map v2",
  "type": "object",
  "required": ["schema", "status", "qualification", "platform", "platform_sha256", "tool", "probe_rtl", "probe_rtl_sha256", "parts", "transceiver_sites", "validation"],
  "properties": {
    "schema": {"const": "emuflow.vivado-pin-site-map/v2"},
    "status": {"const": "pass"},
    "qualification": {"const": "vendor_device_db_derived_from_source_backed_package_pins"},
    "platform": {"type": "string", "minLength": 1},
    "platform_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tool": {"type": "object"},
    "probe_rtl": {"type": "string", "minLength": 1},
    "probe_rtl_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parts": {"type": "array", "minItems": 1},
    "transceiver_sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fpga", "part", "link", "connector", "mgt_group", "physical_lane", "package_pins", "pin_functions", "site", "common_site"],
        "properties": {
          "site": {"type": "string", "pattern": "^GT[YH]E4_CHANNEL_X[0-9]+Y[0-9]+$"},
          "common_site": {"type": "string", "pattern": "^GT[YH]E4_COMMON_X[0-9]+Y[0-9]+$"}
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["fpgas", "endpoint_lanes", "package_pins", "pin_function_mismatches", "cross_site_lane_mismatches", "cross_common_lane_mismatches"],
      "properties": {
        "pin_function_mismatches": {"const": 0},
        "cross_site_lane_mismatches": {"const": 0},
        "cross_common_lane_mismatches": {"const": 0}
      }
    }
  },
  "additionalProperties": false
}
