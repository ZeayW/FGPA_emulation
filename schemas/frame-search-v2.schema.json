{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schemas/frame-search-v2.schema.json",
  "title": "EmuFlow checked minimum-frame search",
  "type": "object",
  "required": [
    "schema",
    "status",
    "provider",
    "objective",
    "maximum_frame_slots",
    "selected_frame_slots",
    "speedup_over_maximum",
    "evaluated_candidates",
    "configuration",
    "attempts",
    "selected_candidate"
  ],
  "properties": {
    "schema": {"const": "emuflow.frame-search/v2"},
    "status": {"const": "pass"},
    "provider": {"const": "checked-monotone-bisection-v1"},
    "objective": {"const": "minimum-feasible-frame-slots"},
    "maximum_frame_slots": {"type": "integer", "minimum": 2},
    "selected_frame_slots": {"type": "integer", "minimum": 2},
    "speedup_over_maximum": {"type": "number", "minimum": 1},
    "evaluated_candidates": {"type": "integer", "minimum": 1},
    "configuration": {"type": "object"},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    },
    "selected_candidate": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
