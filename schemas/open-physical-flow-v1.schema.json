{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schemas/open-physical-flow-v1.schema.json",
  "title": "EmuFlow open physical-flow report v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "provider",
    "top",
    "sources",
    "hard_blocks",
    "architecture_source",
    "array",
    "stages",
    "summary"
  ],
  "properties": {
    "schema": {"const": "emuflow.open-physical-flow/v1"},
    "status": {"const": "pass"},
    "provider": {"type": "string", "minLength": 1},
    "top": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "hard_blocks": {"type": "boolean"},
    "architecture_source": {
      "type": "object",
      "required": ["status", "mode", "sha256"],
      "properties": {
        "status": {"const": "pass"},
        "mode": {"enum": ["pinned-fetch", "provided"]},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "array": {"$ref": "#/$defs/array"},
    "stages": {
      "type": "object",
      "required": [
        "synthesis",
        "baseline_vpr",
        "architecture_import",
        "packed_contract",
        "openparf_placement",
        "final_vpr_route"
      ],
      "properties": {
        "synthesis": {"$ref": "#/$defs/passedStage"},
        "baseline_vpr": {"$ref": "#/$defs/passedStage"},
        "architecture_import": {"$ref": "#/$defs/passedStage"},
        "packed_contract": {"$ref": "#/$defs/passedStage"},
        "openparf_placement": {"$ref": "#/$defs/passedStage"},
        "final_vpr_route": {"$ref": "#/$defs/passedStage"}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["status", "design", "array", "hard_blocks"],
      "properties": {
        "status": {"const": "pass"},
        "design": {"type": "string", "minLength": 1},
        "array": {"$ref": "#/$defs/array"},
        "hard_blocks": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "array": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "passedStage": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"const": "pass"}},
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
