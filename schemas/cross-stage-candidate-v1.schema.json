{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schemas/cross-stage-candidate-v1.schema.json",
  "title": "EmuFlow checked Phase 3--5 candidate",
  "type": "object",
  "required": [
    "schema",
    "status",
    "design",
    "platform",
    "candidate_id",
    "source_sha256",
    "path_metrics",
    "objective",
    "objective_metrics",
    "objective_key"
  ],
  "properties": {
    "schema": {"const": "emuflow.cross-stage-candidate/v1"},
    "status": {"const": "pass"},
    "design": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "candidate_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "path_metrics": {"type": "object"},
    "objective": {"type": "string", "minLength": 1},
    "objective_metrics": {"type": "object"},
    "objective_key": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"type": "number"}
    }
  },
  "additionalProperties": false
}
