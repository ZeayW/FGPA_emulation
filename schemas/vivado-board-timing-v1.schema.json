{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/vivado-board-timing-v1.schema.json",
  "title": "EmuFlow board-integrated Vivado timing feedback v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "qualification",
    "design",
    "platform",
    "source_bindings",
    "fpgas",
    "board_link_timing",
    "system_timing",
    "artifacts",
    "summary"
  ],
  "properties": {
    "schema": {"const": "emuflow.vivado-board-timing/v1"},
    "status": {"const": "pass"},
    "qualification": {
      "enum": [
        "routed-board-stage-timing-plus-link-model-only",
        "routed-board-maxima-plus-interface-measurements-link-model-only"
      ]
    },
    "fpgas": {"type": "array", "minItems": 1},
    "board_link_timing": {
      "type": "object",
      "required": ["status", "source", "known", "unknown", "final_system_signoff"],
      "properties": {
        "status": {
          "enum": [
            "modeled-not-measured",
            "modeled-or-characterized-upper-bound",
            "measured-upper-bound"
          ]
        },
        "final_link_timing_signoff": {"type": "boolean"},
        "final_system_signoff": {"const": false}
      }
    },
    "system_timing": {
      "type": "object",
      "required": [
        "status",
        "qualification",
        "timing_paths",
        "maximum_system_delay_bound_ns",
        "runtime_period_ns",
        "runtime_wns_ns",
        "path_exactness"
      ]
    }
  }
}
