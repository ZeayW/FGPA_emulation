{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/multi-fpga-flow-v2.schema.json",
  "title": "EmuFlow provider-neutral multi-FPGA flow report v2",
  "type": "object",
  "required": ["schema", "status", "provider", "architecture_policy", "runtime", "stages", "artifacts", "summary"],
  "properties": {
    "schema": {"const": "emuflow.multi-fpga-flow/v2"},
    "status": {"const": "pass"},
    "provider": {"type": "string", "minLength": 1},
    "architecture_policy": {"const": "provider-neutral"},
    "runtime": {"type": "object"},
    "physical": {"type": "object"},
    "hardware_bsp": {
      "type": "object",
      "properties": {
        "schema": {"const": "emuflow.multi-fpga-bsp-flow/v1"},
        "status": {"const": "pass"}
      },
      "required": ["schema", "status"]
    },
    "stages": {
      "type": "object",
      "required": ["frontend", "partition", "system_route", "tdm", "split"]
    },
    "artifacts": {"type": "object"},
    "summary": {
      "type": "object",
      "required": ["status", "design", "platform", "physical_status", "hardware_bsp_status"]
    }
  },
  "additionalProperties": true
}
