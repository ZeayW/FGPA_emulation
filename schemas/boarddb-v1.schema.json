{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/boarddb-v1.schema.json",
  "title": "EmuFlow virtual/hardware BoardDB v1",
  "type": "object",
  "required": ["schema", "platform", "fpgas", "links"],
  "properties": {
    "schema": {"const": "emuflow.boarddb/v1"},
    "platform": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": {"type": "string"},
        "kind": {"enum": ["virtual", "hardware"]}
      }
    },
    "fpgas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "part", "capacity", "utilization_limit"]
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capacity_sharing": {
            "enum": ["per_direction", "shared_bidirectional"]
          },
          "payload_bits_per_lane_per_cycle": {
            "type": "integer",
            "minimum": 1
          },
          "max_line_rate_gbps_per_lane": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "endpoints",
          "direction",
          "mode",
          "data_lanes_per_direction",
          "fabric_clock_mhz",
          "latency_cycles"
        ]
      }
    }
  },
  "additionalProperties": true
}
