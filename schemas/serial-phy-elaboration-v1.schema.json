{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/serial-phy-elaboration-v1.schema.json",
  "title": "EmuFlow serial PHY elaboration report v1",
  "type": "object",
  "required": ["schema", "status", "qualification", "design", "platform", "provider", "provider_qualification", "tool", "phase6c_manifest_sha256", "provider_manifest_sha256", "runtime_controller_sha256", "fpgas", "validation"],
  "properties": {
    "schema": {"const": "emuflow.serial-phy-elaboration/v1"},
    "status": {"const": "pass"},
    "qualification": {
      "enum": ["open_rtl_elaboration_only", "vivado_rtl_elaboration_only"]
    },
    "fpgas": {"type": "array", "minItems": 1},
    "validation": {
      "type": "object",
      "required": ["fpgas", "elaboration_failures", "hardware_release_authorized"],
      "properties": {
        "elaboration_failures": {"const": 0},
        "hardware_release_authorized": {"const": false}
      }
    }
  }
}
