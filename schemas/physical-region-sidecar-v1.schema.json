{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schemas/physical-region-sidecar-v1.schema.json",
  "title": "EmuFlow source-qualified physical-region sidecar v1",
  "type": "object",
  "required": [
    "schema",
    "part",
    "source",
    "slrs",
    "clock_regions",
    "site_region_groups",
    "io_banks"
  ],
  "properties": {
    "schema": {"const": "emuflow.physical-region-sidecar/v1"},
    "part": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["producer", "producer_version", "qualification"],
      "properties": {
        "producer": {"type": "string", "minLength": 1},
        "producer_version": {"type": "string", "minLength": 1},
        "qualification": {"type": "string", "minLength": 1},
        "architecture_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "slrs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "index"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "index": {"type": "integer", "minimum": 0}
        }
      }
    },
    "clock_regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "slr", "grid_x", "grid_y"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "slr": {"type": "string", "minLength": 1},
          "grid_x": {"type": "integer", "minimum": 0},
          "grid_y": {"type": "integer", "minimum": 0}
        }
      }
    },
    "site_region_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slr", "clock_region", "sites"],
        "properties": {
          "slr": {"type": "string", "minLength": 1},
          "clock_region": {"type": "string", "minLength": 1},
          "sites": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "io_banks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "bank_type", "package", "pins"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "bank_type": {"type": "string", "minLength": 1},
          "package": {"type": "string", "minLength": 1},
          "pins": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["package_pin", "site", "bel"],
              "properties": {
                "package_pin": {"type": "string", "minLength": 1},
                "site": {"type": "string", "minLength": 1},
                "bel": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
