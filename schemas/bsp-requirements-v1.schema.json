{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/bsp-requirements-v1.schema.json",
  "title": "EmuFlow hardware BSP requirements v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "design",
    "platform",
    "release",
    "target",
    "requirements",
    "metrics"
  ],
  "properties": {
    "schema": {"const": "emuflow.bsp-requirements/v1"},
    "status": {"const": "awaiting_hardware_bsp"},
    "design": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "release": {
      "type": "object",
      "required": ["source_commit", "manifest_sha256", "gates_closed"]
    },
    "target": {
      "type": "object",
      "required": ["required_boarddb_kind", "fpgas", "links"]
    },
    "requirements": {
      "type": "object",
      "required": [
        "logical_anchor_bindings",
        "physical_data_lane_bindings",
        "fabric_clock_bindings",
        "link_channel_bindings",
        "bitstreams",
        "board_shell",
        "bringup_checks"
      ]
    },
    "metrics": {"type": "object"}
  },
  "additionalProperties": false
}
