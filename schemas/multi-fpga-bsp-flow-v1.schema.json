{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/multi-fpga-bsp-flow-v1.schema.json",
  "title": "EmuFlow multi-FPGA hardware-BSP continuation report v1",
  "type": "object",
  "required": ["schema", "status", "design", "platform", "qualification", "hardware_release_status", "source_flow_report_sha256", "stages", "validation", "artifacts", "summary"],
  "properties": {
    "schema": {"const": "emuflow.multi-fpga-bsp-flow/v1"},
    "status": {"const": "pass"},
    "design": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "qualification": {"const": "source_bound_bsp_structure_validation"},
    "hardware_release_status": {"type": "string", "minLength": 1},
    "source_flow_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stages": {
      "type": "object",
      "required": ["phase6b", "runtime_sync", "phase6c", "phy_elaboration"]
    },
    "validation": {
      "type": "object",
      "required": ["fpgas", "elaboration_failures", "hardware_release_authorized", "gt_site_map_status"],
      "properties": {
        "fpgas": {"type": "integer", "minimum": 1},
        "elaboration_failures": {"const": 0},
        "hardware_release_authorized": {"const": false},
        "gt_site_map_status": {"type": "string", "minLength": 1}
      }
    }
  }
}
