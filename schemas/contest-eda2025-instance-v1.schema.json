{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/contest-eda2025-instance-v1.schema.json",
  "title": "Normalized 2025 EDA Elite multi-FPGA routing instance",
  "type": "object",
  "required": [
    "schema",
    "name",
    "source",
    "parameters",
    "fpga_ids",
    "max_external_channels",
    "initial_topology",
    "nets",
    "node_assignment"
  ],
  "properties": {
    "schema": {"const": "emuflow.contest-eda2025-instance/v1"},
    "name": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["contest", "problem", "specification_url"]
    },
    "parameters": {
      "type": "object",
      "required": [
        "alpha_ns",
        "beta_ns",
        "ratio_quantum",
        "max_ratio",
        "topology_change_fraction"
      ]
    },
    "fpga_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "max_external_channels": {"type": "object"},
    "initial_topology": {"type": "array"},
    "nets": {"type": "array", "minItems": 1},
    "node_assignment": {"type": "object"}
  },
  "additionalProperties": false
}
