{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/board-support-overlay-v1.schema.json",
  "title": "EmuFlow board support overlay v1",
  "type": "object",
  "required": ["schema", "platform", "qualification", "provenance", "reference_clocks", "resets", "transceiver_sites"],
  "properties": {
    "schema": {"const": "emuflow.board-support-overlay/v1"},
    "platform": {"type": "string", "minLength": 1},
    "qualification": {"enum": ["source_backed_hardware_definition", "user_supplied_unverified"]},
    "provenance": {
      "type": "object",
      "required": ["sources"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["title", "uri", "locator"],
            "properties": {
              "title": {"type": "string", "minLength": 1},
              "uri": {"type": "string", "minLength": 1},
              "locator": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "reference_clocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fpga", "board_service", "selected_signal", "package_pins", "frequency_mhz", "frequency_basis"]
      }
    },
    "resets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fpga", "board_service", "package_pin"]
      }
    },
    "transceiver_sites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fpga", "link", "connector", "mgt_group", "physical_lane", "site", "reference_clock_binding"]
      }
    }
  },
  "additionalProperties": false
}
