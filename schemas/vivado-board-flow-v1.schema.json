{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/vivado-board-flow-v1.schema.json",
  "title": "EmuFlow board-integrated Vivado implementation report v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "qualification",
    "design",
    "platform",
    "tool",
    "source_bindings",
    "fpgas",
    "release",
    "summary"
  ],
  "properties": {
    "schema": {"const": "emuflow.vivado-board-flow/v1"},
    "status": {"const": "pass"},
    "qualification": {
      "const": "vivado_ooc_board_integrated_place_route"
    },
    "fpgas": {"type": "array", "minItems": 1},
    "release": {
      "type": "object",
      "required": [
        "hardware_release_authorized",
        "bitstreams_generated",
        "blocked_on"
      ],
      "properties": {
        "hardware_release_authorized": {"const": false},
        "bitstreams_generated": {"const": 0},
        "blocked_on": {"type": "array", "minItems": 1}
      }
    }
  }
}
