{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schemas/combinational-cut-characterization-v1.schema.json",
  "title": "EmuFlow combinational-cut characterization v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "qualification",
    "design",
    "behavior_change",
    "source_identity",
    "slot_edge_convention",
    "instance_classification",
    "combinational_sccs",
    "eligible_cuts",
    "ineligible_combinational_cuts",
    "dependency_edges",
    "depth_limits",
    "current_sequential_only_atomic_components",
    "metrics"
  ],
  "properties": {
    "schema": {"const": "emuflow.combinational-cut-characterization/v1"},
    "status": {"const": "characterized"},
    "qualification": {"const": "analysis-only-no-partition-or-equivalence-claim"},
    "design": {"type": "string", "minLength": 1},
    "behavior_change": {"const": false},
    "source_identity": {"type": "object"},
    "slot_edge_convention": {"type": "object"},
    "instance_classification": {"type": "array"},
    "combinational_sccs": {"type": "array"},
    "eligible_cuts": {"type": "array"},
    "ineligible_combinational_cuts": {"type": "array"},
    "dependency_edges": {"type": "array"},
    "depth_limits": {"type": "array", "minItems": 1},
    "current_sequential_only_atomic_components": {"type": "object"},
    "metrics": {"type": "object"}
  },
  "additionalProperties": false
}
