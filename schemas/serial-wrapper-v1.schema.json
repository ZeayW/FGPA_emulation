{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/serial-wrapper-v1.schema.json",
  "title": "EmuFlow serial wrapper contract v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "design",
    "platform",
    "binding_provider",
    "phy_contract",
    "fpgas",
    "metrics"
  ],
  "properties": {
    "schema": {"const": "emuflow.serial-wrapper/v1"},
    "status": {
      "enum": ["awaiting_external_phy_provider", "provider_source_bound"]
    },
    "design": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "binding_provider": {
      "const": "boarddb-fixed-serial-transceiver-v1"
    },
    "phy_contract": {
      "type": "object",
      "required": [
        "module",
        "rtl",
        "implementation_status",
        "required_provider_fields",
        "internal_reset",
        "board_service_candidates",
        "board_support_overlay",
        "provider"
      ],
      "properties": {
        "implementation_status": {
          "enum": [
            "black_box_unresolved",
            "simulation_source_bound",
            "editable_source_bound_pending_tool_validation"
          ]
        },
        "required_provider_fields": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "internal_reset": {
          "type": "object",
          "required": ["signal", "polarity", "derivation_status"]
        },
        "board_service_candidates": {
          "type": "object",
          "required": ["reference_clocks", "resets"],
          "properties": {
            "reference_clocks": {"type": "array"},
            "resets": {"type": "array"}
          }
        },
        "board_support_overlay": {
          "type": "object",
          "required": ["status"]
        },
        "provider": {
          "type": "object",
          "required": ["status"]
        }
      }
    },
    "runtime_sync": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["not_provided", "source_inventory_bound"]}
      }
    },
    "fpgas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "fpga",
          "part",
          "module",
          "rtl",
          "active_transceiver_sites",
          "active_tx_directions",
          "active_rx_directions",
          "transport_connections",
          "board_services",
          "board_service_constraints_status",
          "gt_site_constraints_status",
          "transceiver_quads",
          "sites"
        ],
        "properties": {
          "transceiver_quads": {"type": "array"}
        }
      }
    },
    "metrics": {"type": "object"},
    "binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "board_overlay_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phy_provider_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "vivado_gt_site_map_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_sync_topology_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_sync_provider_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
