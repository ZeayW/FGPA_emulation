{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schemas/vpr-packed-netlist-v1.schema.json",
  "title": "EmuFlow VPR Packed Netlist",
  "type": "object",
  "required": ["schema", "design", "source", "clusters", "nets"],
  "properties": {
    "schema": {"const": "emuflow.vpr-packed-netlist/v1"},
    "design": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": [
        "format",
        "path",
        "sha256",
        "root_instance",
        "architecture_id",
        "atom_netlist_id"
      ],
      "properties": {
        "format": {"const": "vpr-packed-net-xml/v1"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "root_instance": {"type": "string", "minLength": 1},
        "architecture_id": {
          "type": "string",
          "pattern": "^SHA256:[0-9a-f]{64}$"
        },
        "atom_netlist_id": {
          "type": "string",
          "pattern": "^SHA256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "clusters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "instance",
          "block_type",
          "mode",
          "pb_blocks",
          "atoms"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string"},
          "instance": {"type": "string", "minLength": 1},
          "block_type": {"type": "string", "minLength": 1},
          "mode": {"type": "string"},
          "pb_blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "name",
                "instance",
                "mode",
                "leaf"
              ],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "name": {"type": "string"},
                "instance": {"type": "string", "minLength": 1},
                "mode": {"type": "string"},
                "leaf": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          },
          "atoms": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "nets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "driver", "sinks"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "driver": {"type": "string", "minLength": 1},
          "sinks": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
