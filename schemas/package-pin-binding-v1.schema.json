{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schemas/package-pin-binding-v1.schema.json",
  "title": "EmuFlow physical package-pin binding",
  "type": "object",
  "required": [
    "schema",
    "status",
    "design",
    "platform",
    "board",
    "provider",
    "configuration",
    "weights",
    "metrics",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "emuflow.package-pin-binding/v1"
    },
    "status": {
      "enum": [
        "synthetic_validation",
        "planned_hardware"
      ]
    },
    "design": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "board": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "const": "chimew-package-pin-min-cost-flow-v1"
    },
    "configuration": {
      "type": "object"
    },
    "weights": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "group",
          "link",
          "source",
          "sink",
          "physical_lane",
          "channel",
          "source_port",
          "sink_port",
          "source_package_pin",
          "sink_package_pin",
          "source_bank",
          "sink_bank",
          "connector",
          "iostandard",
          "cost"
        ]
      }
    }
  },
  "additionalProperties": false
}
