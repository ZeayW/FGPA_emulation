{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schemas/hardware-bsp-v1.schema.json",
  "title": "EmuFlow physical hardware BSP",
  "type": "object",
  "required": [
    "schema",
    "platform",
    "board",
    "fpgas",
    "channels"
  ],
  "properties": {
    "schema": {
      "const": "emuflow.hardware-bsp/v1"
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "board": {
      "type": "object",
      "required": [
        "name",
        "revision",
        "qualification"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "qualification": {
          "enum": [
            "synthetic_validation",
            "hardware_definition"
          ]
        }
      },
      "additionalProperties": true
    },
    "fpgas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "part",
          "banks",
          "pins"
        ]
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "link",
          "source",
          "sink",
          "source_pin",
          "sink_pin",
          "iostandard",
          "max_frequency_mhz",
          "skew_ps"
        ]
      }
    }
  },
  "additionalProperties": false
}
