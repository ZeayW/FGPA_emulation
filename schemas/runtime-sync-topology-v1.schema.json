{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/runtime-sync-topology-v1.schema.json",
  "title": "EmuFlow rooted-tree runtime synchronization topology v1",
  "type": "object",
  "required": ["schema", "platform", "provider", "algorithm", "root", "parameters", "nodes", "fault_policy", "board_proof", "hardware_release_status"],
  "properties": {
    "schema": {"const": "emuflow.runtime-sync-topology/v1"},
    "platform": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "algorithm": {"const": "rooted-tree-future-epoch-barrier"},
    "root": {"type": "string", "minLength": 1},
    "parameters": {"type": "object"},
    "nodes": {"type": "array", "minItems": 1},
    "fault_policy": {"const": "sticky-fault-requires-global-reset"},
    "board_proof": {"type": "object"},
    "hardware_release_status": {"enum": ["blocked_on_board_sync_binding", "source_backed_hardware"]}
  },
  "additionalProperties": false
}
