{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.org/schemas/validation-farm-v1.schema.json",
  "title": "EmuFlow validation farm specification",
  "type": "object",
  "required": [
    "schema",
    "farm_id",
    "source_commit",
    "install_dir",
    "nodes",
    "tasks"
  ],
  "properties": {
    "schema": {
      "const": "emuflow.validation-farm-spec/v1"
    },
    "farm_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "install_dir": {
      "type": "string",
      "pattern": "^/"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      }
    },
    "slots_per_node": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "ssh": {
      "type": "object",
      "properties": {
        "executable": {"type": "string", "minLength": 1},
        "arguments": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "worker_argv": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "command"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "node": {"type": "string"},
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "cwd": {"type": "string"},
          "environment": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
