{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/runtime-sync-provider-v1.schema.json",
  "title": "EmuFlow source-visible runtime synchronization provider v1",
  "type": "object",
  "required": ["schema", "id", "qualification", "modules", "implementation", "source_root", "sources", "requirements", "provenance"],
  "properties": {
    "schema": {"const": "emuflow.runtime-sync-provider/v1"},
    "id": {"type": "string", "minLength": 1},
    "qualification": {"enum": ["editable_source_hardware", "simulation_only"]},
    "modules": {
      "type": "object",
      "required": ["tree_node"],
      "properties": {
        "tree_node": {"const": "emuflow_runtime_sync_tree_node"}
      },
      "additionalProperties": false
    },
    "implementation": {
      "type": "object",
      "required": ["algorithm", "fault_policy"],
      "properties": {
        "algorithm": {"const": "rooted-tree-future-epoch-barrier"},
        "fault_policy": {"const": "sticky-fault-requires-global-reset"}
      },
      "additionalProperties": false
    },
    "source_root": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "language", "role", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "language": {"enum": ["systemverilog", "verilog"]},
          "role": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "requirements": {
      "type": "object",
      "required": ["fabric_clock", "reset_release", "control_transport"],
      "properties": {
        "fabric_clock": {"const": "phase-aligned-common-frequency"},
        "reset_release": {"const": "synchronous-all-fpgas"},
        "control_transport": {"const": "lossless-ordered-tree-links"}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["license", "upstream"]
    }
  },
  "additionalProperties": false
}
