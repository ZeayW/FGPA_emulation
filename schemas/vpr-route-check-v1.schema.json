{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schemas/vpr-route-check-v1.schema.json",
  "title": "EmuFlow VPR Route Check",
  "type": "object",
  "required": [
    "schema",
    "status",
    "provider",
    "design",
    "checks",
    "packed_nets",
    "global_nets",
    "routed_nets",
    "route_nodes",
    "route_edges",
    "branch_restarts",
    "rr_nodes",
    "rr_edges",
    "max_occupancy",
    "max_capacity",
    "array",
    "artifacts"
  ],
  "properties": {
    "schema": {"const": "emuflow.vpr-route-check/v1"},
    "status": {"const": "pass"},
    "provider": {"const": "emuflow-cpp-vpr-route-checker"},
    "design": {"type": "string", "minLength": 1},
    "checks": {
      "type": "object",
      "additionalProperties": {"const": "pass"}
    },
    "packed_nets": {"type": "integer", "minimum": 1},
    "global_nets": {"type": "integer", "minimum": 0},
    "routed_nets": {"type": "integer", "minimum": 0},
    "route_nodes": {"type": "integer", "minimum": 1},
    "route_edges": {"type": "integer", "minimum": 1},
    "branch_restarts": {"type": "integer", "minimum": 0},
    "rr_nodes": {"type": "integer", "minimum": 1},
    "rr_edges": {"type": "integer", "minimum": 1},
    "max_occupancy": {"type": "integer", "minimum": 1},
    "max_capacity": {"type": "integer", "minimum": 1},
    "array": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "artifacts": {"type": "object"}
  },
  "additionalProperties": false
}
