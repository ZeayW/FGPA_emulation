{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/serial-phy-recipe-v1.schema.json",
  "title": "EmuFlow vendor-generated serial PHY recipe v1",
  "type": "object",
  "required": ["schema", "id", "qualification", "generator", "supported_parts", "recipe", "expected_ips", "expected_primitives", "protocol", "provenance"],
  "properties": {
    "schema": {"const": "emuflow.serial-phy-recipe/v1"},
    "id": {"type": "string", "minLength": 1},
    "qualification": {"const": "vendor_generated_hardware"},
    "generator": {"const": "vivado_gtwizard_ultrascale"},
    "supported_parts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "recipe": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "expected_ips": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "expected_primitives": {
      "type": "object",
      "required": ["channel", "common"],
      "properties": {
        "channel": {"type": "string", "minLength": 1},
        "common": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "required": ["line_rate_gbps_per_lane", "reference_clock_mhz", "encoding"],
      "properties": {
        "line_rate_gbps_per_lane": {"type": "number", "exclusiveMinimum": 0},
        "reference_clock_mhz": {"type": "number", "exclusiveMinimum": 0},
        "encoding": {"type": "string", "minLength": 1},
        "payload_bits_per_lane_per_cycle": {"type": "integer", "minimum": 1},
        "user_clock_mhz": {"type": "number", "exclusiveMinimum": 0},
        "link_training": {"type": "string", "minLength": 1},
        "reset_sequence": {"type": "string", "minLength": 1},
        "pcs_data_width": {"type": "integer", "minimum": 1},
        "pcs_header_width": {"type": "integer", "minimum": 1},
        "pcs_clock_mhz": {"type": "number", "exclusiveMinimum": 0},
        "pcs_implementation": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "required": ["schema", "id", "modules", "implementation"],
      "properties": {
        "schema": {"const": "emuflow.serial-phy-provider/v3"},
        "id": {"type": "string", "minLength": 1},
        "modules": {"type": "object"},
        "implementation": {"type": "object"}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["license", "upstream", "revision"],
      "properties": {
        "license": {"type": "string", "minLength": 1},
        "upstream": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
