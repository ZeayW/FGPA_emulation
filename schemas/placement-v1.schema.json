{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schemas/placement-v1.schema.json",
  "title": "EmuFlow Placement v1",
  "type": "object",
  "required": ["schema", "part", "source", "cells"],
  "properties": {
    "schema": {"const": "emuflow.placement/v1"},
    "part": {"type": "string", "minLength": 1},
    "source": {"type": "object"},
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "instance", "cell_type", "site", "bel",
          "x", "y", "z", "fixed"
        ],
        "properties": {
          "instance": {"type": "string", "minLength": 1},
          "cell_type": {"type": "string", "minLength": 1},
          "site": {"type": "string", "minLength": 1},
          "bel": {"type": "string", "minLength": 1},
          "x": {"type": "integer", "minimum": 0},
          "y": {"type": "integer", "minimum": 0},
          "z": {"type": "integer", "minimum": 0},
          "fixed": {"type": "boolean"}
        }
      }
    }
  }
}
