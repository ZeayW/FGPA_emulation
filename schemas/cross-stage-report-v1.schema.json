{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schemas/cross-stage-report-v1.schema.json",
  "title": "EmuFlow Phase 3--5 feedback optimization report",
  "type": "object",
  "required": [
    "schema",
    "status",
    "design",
    "platform",
    "provider",
    "objective",
    "configuration",
    "source_sha256",
    "selected_iteration",
    "selected_candidate_id",
    "termination",
    "candidates"
  ],
  "properties": {
    "schema": {"const": "emuflow.cross-stage-report/v1"},
    "status": {"const": "pass"},
    "design": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "provider": {
      "const": "tdm-feedback-proximal-line-search-v1"
    },
    "objective": {"type": "string", "minLength": 1},
    "configuration": {"type": "object"},
    "source_sha256": {"type": "object"},
    "selected_iteration": {"type": "integer", "minimum": 0},
    "selected_candidate_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "termination": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    }
  },
  "additionalProperties": false
}
