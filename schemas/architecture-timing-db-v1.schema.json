{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schemas/architecture-timing-db-v1.schema.json",
  "title": "EmuFlow Architecture TimingDB v1",
  "type": "object",
  "required": [
    "schema",
    "architecture",
    "name",
    "source",
    "primitives",
    "primitive_arcs",
    "block_interconnect_arcs",
    "routing"
  ],
  "properties": {
    "schema": {"const": "emuflow.architecture-timing-db/v1"},
    "architecture": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["format", "sha256", "qualification"],
      "properties": {
        "format": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "qualification": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1}
      }
    },
    "primitives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "cell", "model", "class", "ports"]
      }
    },
    "primitive_arcs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/arc"}
    },
    "block_interconnect_arcs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/arc"}
    },
    "routing": {
      "type": "object",
      "required": ["switches", "segments", "directs"],
      "properties": {
        "switches": {"type": "array", "minItems": 1},
        "segments": {"type": "array", "minItems": 1},
        "directs": {"type": "array"}
      }
    }
  },
  "$defs": {
    "arc": {
      "type": "object",
      "required": ["scope", "kind", "min_seconds", "max_seconds"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "min_seconds": {"type": "number", "minimum": 0},
        "max_seconds": {"type": "number", "minimum": 0}
      }
    }
  }
}
