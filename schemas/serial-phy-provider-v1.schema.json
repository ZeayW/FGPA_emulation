{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emuflow.dev/schema/serial-phy-provider-v1.schema.json",
  "title": "EmuFlow editable-source serial PHY provider v1",
  "type": "object",
  "required": ["schema", "id", "qualification", "supported_parts", "modules", "implementation", "source_root", "sources", "protocol", "provenance"],
  "properties": {
    "schema": {"const": "emuflow.serial-phy-provider/v1"},
    "id": {"type": "string", "minLength": 1},
    "qualification": {"enum": ["editable_source_hardware", "simulation_only"]},
    "supported_parts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "modules": {
      "type": "object",
      "required": ["clock_reset", "lane"],
      "properties": {
        "clock_reset": {"const": "emuflow_external_serial_clock_reset"},
        "lane": {"const": "emuflow_external_serial_phy_lane"}
      },
      "additionalProperties": false
    },
    "implementation": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["behavioral", "amd_ultrascale_plus_gty"]},
        "channel_primitive": {"type": "string", "minLength": 1},
        "reference_clock_primitive": {"type": "string", "minLength": 1}
      }
    },
    "source_root": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "language", "role", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "language": {"enum": ["systemverilog", "verilog", "tcl", "xdc"]},
          "role": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "protocol": {
      "type": "object",
      "required": ["payload_bits_per_lane_per_cycle", "user_clock_mhz", "line_rate_gbps_per_lane", "encoding", "link_training", "reset_sequence"]
    },
    "provenance": {
      "type": "object",
      "required": ["license", "upstream"]
    }
  },
  "additionalProperties": false
}
