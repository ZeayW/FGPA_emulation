<?xml version="1.0"?>
<!--
  SPDX-License-Identifier: Apache-2.0
  Compact VTR-schema fixture for the EmuFlow architecture adapter.
  It is intentionally small; production validation uses the pinned VTR
  flagship architecture recorded in resources/architectures/vtr.
-->
<architecture>
  <models>
    <model name="multiply">
      <input_ports>
        <port name="a" combinational_sink_ports="out"/>
        <port name="b" combinational_sink_ports="out"/>
      </input_ports>
      <output_ports><port name="out"/></output_ports>
    </model>
    <model name="single_port_ram">
      <input_ports>
        <port name="addr" clock="clk"/>
        <port name="data" clock="clk"/>
        <port name="we" clock="clk"/>
        <port name="clk" is_clock="1"/>
      </input_ports>
      <output_ports><port name="out" clock="clk"/></output_ports>
    </model>
  </models>

  <tiles>
    <tile name="io">
      <sub_tile name="io" capacity="8">
        <equivalent_sites><site pb_type="io"/></equivalent_sites>
      </sub_tile>
    </tile>
    <tile name="clb">
      <sub_tile name="clb">
        <equivalent_sites><site pb_type="clb"/></equivalent_sites>
      </sub_tile>
    </tile>
    <tile name="mult_36" height="4">
      <sub_tile name="mult_36">
        <equivalent_sites><site pb_type="mult_36"/></equivalent_sites>
      </sub_tile>
    </tile>
    <tile name="memory" height="6">
      <sub_tile name="memory">
        <equivalent_sites><site pb_type="memory"/></equivalent_sites>
      </sub_tile>
    </tile>
  </tiles>

  <layout>
    <auto_layout aspect_ratio="1.0">
      <perimeter type="io" priority="100"/>
      <corners type="EMPTY" priority="101"/>
      <fill type="clb" priority="10"/>
      <col type="memory" startx="2" starty="1"
           repeatx="8" priority="20"/>
      <col type="EMPTY" startx="2" starty="1"
           repeatx="8" priority="19"/>
      <col type="mult_36" startx="6" starty="1"
           repeatx="8" priority="20"/>
      <col type="EMPTY" startx="6" starty="1"
           repeatx="8" priority="19"/>
    </auto_layout>
  </layout>

  <device>
    <sizing R_minW_nmos="8926" R_minW_pmos="16067"/>
    <area grid_logic_tile_area="53894"/>
    <chan_width_distr>
      <x distr="uniform" peak="1.0"/>
      <y distr="uniform" peak="1.0"/>
    </chan_width_distr>
    <switch_block type="wilton" fs="3"/>
    <connection_block input_switch_name="ipin_cblock"/>
  </device>

  <switchlist>
    <switch type="mux" name="routing_mux"
            R="551" Cin="0.77e-15" Cout="4e-15"
            Tdel="58e-12"/>
    <switch type="mux" name="ipin_cblock"
            R="2231.5" Cin="1.47e-15" Cout="0"
            Tdel="72.47e-12"/>
  </switchlist>

  <segmentlist>
    <segment freq="1.0" length="4" type="unidir"
             Rmetal="101" Cmetal="22.5e-15">
      <mux name="routing_mux"/>
      <sb type="pattern">1 1 1 1 1</sb>
      <cb type="pattern">1 1 1 1</cb>
    </segment>
  </segmentlist>

  <directlist>
    <direct name="carry" from_pin="clb.cout" to_pin="clb.cin"
            x_offset="0" y_offset="-1" z_offset="0"/>
  </directlist>

  <complexblocklist>
    <pb_type name="io">
      <mode name="input">
        <pb_type name="inpad" blif_model=".input">
          <output name="inpad" num_pins="1"/>
        </pb_type>
      </mode>
      <mode name="output">
        <pb_type name="outpad" blif_model=".output">
          <input name="outpad" num_pins="1"/>
        </pb_type>
      </mode>
    </pb_type>

    <pb_type name="clb">
      <input name="I" num_pins="40"/>
      <output name="O" num_pins="20"/>
      <clock name="clk" num_pins="1"/>
      <pb_type name="fle" num_pb="10">
        <input name="in" num_pins="6"/>
        <output name="out" num_pins="2"/>
        <clock name="clk" num_pins="1"/>
        <mode name="lut6">
          <pb_type name="lut6" blif_model=".names" class="lut">
            <input name="in" num_pins="6"/>
            <output name="out" num_pins="1"/>
            <delay_matrix type="max" in_port="lut6.in"
                          out_port="lut6.out">
              2.61e-10 2.61e-10 2.61e-10
              2.61e-10 2.61e-10 2.61e-10
            </delay_matrix>
            <delay_matrix type="min" in_port="lut6.in"
                          out_port="lut6.out">
              2.10e-10 2.10e-10 2.10e-10
              2.10e-10 2.10e-10 2.10e-10
            </delay_matrix>
          </pb_type>
          <pb_type name="ff" blif_model=".latch" class="flipflop">
            <input name="D" num_pins="1"/>
            <output name="Q" num_pins="1"/>
            <clock name="clk" num_pins="1"/>
            <T_setup value="66e-12" port="ff.D" clock="clk"/>
            <T_clock_to_Q min="60e-12" max="124e-12"
                          port="ff.Q" clock="clk"/>
          </pb_type>
          <interconnect>
            <direct name="lut_to_ff" input="lut6.out" output="ff.D">
              <delay_constant min="24e-12" max="25e-12"
                              in_port="lut6.out" out_port="ff.D"/>
            </direct>
          </interconnect>
        </mode>
        <mode name="fractured_lut5">
          <pb_type name="lut5" blif_model=".names"
                   class="lut" num_pb="2">
            <input name="in" num_pins="5"/>
            <output name="out" num_pins="1"/>
            <delay_constant min="190e-12" max="230e-12"
                            in_port="lut5.in" out_port="lut5.out"/>
          </pb_type>
          <pb_type name="ff" blif_model=".latch"
                   class="flipflop" num_pb="2">
            <input name="D" num_pins="1"/>
            <output name="Q" num_pins="1"/>
            <clock name="clk" num_pins="1"/>
            <T_setup value="66e-12" port="ff.D" clock="clk"/>
            <T_clock_to_Q min="60e-12" max="124e-12"
                          port="ff.Q" clock="clk"/>
          </pb_type>
        </mode>
      </pb_type>
      <interconnect>
        <complete name="crossbar" input="clb.I fle.out"
                  output="fle.in">
          <delay_constant min="72e-12" max="95e-12"
                          in_port="clb.I" out_port="fle.in"/>
        </complete>
      </interconnect>
    </pb_type>

    <pb_type name="mult_36">
      <mode name="four_mult_9x9">
        <pb_type name="mult_9x9" blif_model=".subckt multiply"
                 num_pb="4">
          <input name="a" num_pins="9"/>
          <input name="b" num_pins="9"/>
          <output name="out" num_pins="18"/>
          <delay_constant min="0.776e-9" max="1.523e-9"
                          in_port="mult_9x9.a"
                          out_port="mult_9x9.out"/>
        </pb_type>
      </mode>
      <mode name="one_mult_36x36">
        <pb_type name="mult_36x36" blif_model=".subckt multiply">
          <input name="a" num_pins="36"/>
          <input name="b" num_pins="36"/>
          <output name="out" num_pins="72"/>
          <delay_constant min="0.776e-9" max="1.523e-9"
                          in_port="mult_36x36.a"
                          out_port="mult_36x36.out"/>
        </pb_type>
      </mode>
    </pb_type>

    <pb_type name="memory">
      <mode name="mem_1024x32">
        <pb_type name="mem_1024x32_sp"
                 blif_model=".subckt single_port_ram"
                 class="memory">
          <input name="addr" num_pins="10"/>
          <input name="data" num_pins="32"/>
          <input name="we" num_pins="1"/>
          <output name="out" num_pins="32"/>
          <clock name="clk" num_pins="1"/>
          <T_setup value="509e-12"
                   port="mem_1024x32_sp.data" clock="clk"/>
          <T_clock_to_Q min="1.196e-9" max="1.234e-9"
                        port="mem_1024x32_sp.out" clock="clk"/>
        </pb_type>
      </mode>
    </pb_type>
  </complexblocklist>
</architecture>
