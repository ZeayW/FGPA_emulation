{
  "schema": "emuflow.source-manifest/v1",
  "policy": {
    "implementation_boundary": "Every default flow engine is editable source in this repository and is built from the repository root.",
    "runtime_boundary": "Compiled executables and extension modules are local build products, never published implementations.",
    "external_tools": "Proprietary tools may be optional comparison or sign-off backends, but may not satisfy an open-flow completion gate."
  },
  "components": [
    {
      "id": "decision-diagram-library",
      "stage": "OpenSTA build dependency",
      "source_paths": [
        "engines/cudd"
      ],
      "build_targets": [
        "cudd_native"
      ],
      "runtime_products": [
        "libcudd"
      ],
      "integration": "default-in-tree-build"
    },
    {
      "id": "open-fpga-architecture-import",
      "stage": "R0 / Phase 2 architecture database",
      "source_paths": [
        "src/native/vtr_architecture_importer.cpp",
        "src/emuflow/vtr_architecture.py",
        "schemas/architecture-timing-db-v1.schema.json",
        "resources/architectures/vtr/flagship-k6-n10-40nm.json",
        "examples/architecture/vtr_k6_heterogeneous_fixture.xml",
        "engines/openparf/thirdparty/pugixml",
        "engines/capnproto",
        "engines/fpga-interchange-schema",
        "src/native/fpga_interchange_arch_importer.cpp",
        "src/emuflow/fpga_interchange.py",
        "src/emuflow/physical_regions.py",
        "schemas/archdb-v1.schema.json",
        "schemas/physical-region-sidecar-v1.schema.json",
        "scripts/rapidwright/export_physical_regions.py"
      ],
      "build_targets": [
        "emuflow_vtr_arch_importer",
        "emuflow_fpgaif_arch_importer",
        "emuflow_python"
      ],
      "runtime_products": [
        "emuflow_vtr_arch_importer",
        "emuflow_fpgaif_arch_importer",
        "emuflow"
      ],
      "integration": "default-in-tree-build"
    },
    {
      "id": "logic-synthesis",
      "stage": "Phase 1",
      "source_paths": [
        "engines/yosys",
        "engines/yosys/abc",
        "src/emuflow/synthesis.py",
        "scripts/yosys/logic_only_map.v"
      ],
      "build_targets": [
        "yosys_native"
      ],
      "runtime_products": [
        "yosys",
        "yosys-abc"
      ],
      "integration": "default-in-tree-build"
    },
    {
      "id": "tritonpart-partitioning",
      "stage": "Phase 3",
      "source_paths": [
        "engines/openroad/src/par",
        "engines/openroad/src/sta",
        "engines/cudd"
      ],
      "build_targets": [
        "cudd_native",
        "openroad_native"
      ],
      "runtime_products": [
        "openroad"
      ],
      "integration": "default-in-tree-build"
    },
    {
      "id": "repart-partitioning",
      "stage": "Phase 3",
      "source_paths": [
        "engines/repart/RePart"
      ],
      "build_targets": [
        "repart"
      ],
      "runtime_products": [
        "repart"
      ],
      "integration": "default-in-tree-build"
    },
    {
      "id": "partition-independent-sta",
      "stage": "R0 / Phase 3/4/5 cross-stage timing projection",
      "source_paths": [
        "src/emuflow/sta.py",
        "src/emuflow/opensta.py",
        "engines/openroad/src/sta",
        "engines/cudd",
        "scripts/opensta/export_timing_path_database.tcl",
        "scripts/vivado/export_timing_path_database.tcl",
        "schemas/sta-path-database-v1.schema.json",
        "schemas/fpga-timing-model-v1.schema.json",
        "resources/timing/ultrascaleplus-softlogic-v1.json"
      ],
      "build_targets": [
        "cudd_native",
        "opensta_native",
        "emuflow_python"
      ],
      "runtime_products": [
        "sta",
        "emuflow"
      ],
      "integration": "default-in-tree-build"
    },
    {
      "id": "partition-tdm-feedback",
      "stage": "Phase 3/4/5 joint optimization",
      "source_paths": [
        "src/native/tdm_partition_feedback.cpp",
        "src/emuflow/partition_feedback.py",
        "src/emuflow/cross_stage.py",
        "schemas/partition-net-weights-v1.schema.json",
        "schemas/cross-stage-candidate-v1.schema.json",
        "schemas/cross-stage-report-v1.schema.json",
        "engines/repart/RePart"
      ],
      "build_targets": [
        "emuflow_tdm_partition_feedback",
        "repart",
        "emuflow_python"
      ],
      "runtime_products": [
        "emuflow_tdm_partition_feedback",
        "repart",
        "emuflow"
      ],
      "integration": "default-in-tree-build"
    },
    {
      "id": "system-routing",
      "stage": "Phase 4/5 route-TDM co-optimization",
      "source_paths": [
        "src/native/tlr_router.cpp",
        "src/emuflow/timing_routing.py"
      ],
      "build_targets": [
        "emuflow_tlr_router"
      ],
      "runtime_products": [
        "emuflow_tlr_router"
      ],
      "integration": "default-in-tree-build"
    },
    {
      "id": "tdm-assignment",
      "stage": "Phase 5",
      "source_paths": [
        "src/native/tdm_ratio_optimizer.cpp",
        "src/emuflow/tdm_ratio.py",
        "src/emuflow/tdm.py",
        "src/emuflow/phase5.py",
        "schemas/tdm-ratio-plan-v1.schema.json"
      ],
      "build_targets": [
        "emuflow_tdm_ratio_optimizer",
        "emuflow_python"
      ],
      "runtime_products": [
        "emuflow_tdm_ratio_optimizer",
        "emuflow"
      ],
      "integration": "default-in-tree-build"
    },
    {
      "id": "netlist-transport-pin-generation",
      "stage": "Phase 6",
      "source_paths": [
        "src/native/placement_aware_pin_planner.cpp",
        "src/native/bsp_pin_solver.cpp",
        "src/emuflow/pin_planning.py",
        "src/emuflow/physical_pins.py",
        "src/emuflow/netlist.py",
        "src/emuflow/phase6.py",
        "schemas/signal-position-hints-v1.schema.json",
        "schemas/placement-aware-pin-plan-v1.schema.json",
        "schemas/hardware-bsp-v1.schema.json",
        "schemas/package-pin-binding-v1.schema.json",
        "scripts/generate_synthetic_vu9p_bsp.py",
        "platforms/synthetic/xcvu9p_4fpga_mesh_bsp.json",
        "rtl/transport"
      ],
      "build_targets": [
        "emuflow_pin_planner",
        "emuflow_bsp_pin_solver",
        "emuflow_python"
      ],
      "runtime_products": [
        "emuflow_pin_planner",
        "emuflow_bsp_pin_solver",
        "emuflow"
      ],
      "integration": "default-in-tree-build"
    },
    {
      "id": "fpga-placement",
      "stage": "Phase 2 / Phase 7",
      "source_paths": [
        "engines/openparf/openparf/placement",
        "engines/openparf/openparf/ops",
        "engines/openparf/openparf/pybind",
        "src/emuflow/openparf.py",
        "src/emuflow/placement.py"
      ],
      "build_targets": [
        "openparf_native"
      ],
      "runtime_products": [
        "openparf/openparf.py",
        "openparf/openparf"
      ],
      "integration": "default-in-tree-build"
    }
  ],
  "open_path_blockers": [
    {
      "id": "default-open-packing-and-timing",
      "status": "partial",
      "reason": "The source-built VTR importer and pinned public flagship model now provide open heterogeneous layout, relaxed capacity, primitive/block timing arcs, and routing switch/segment/direct data. Exact mode-aware packing, architecture-neutral Yosys mapping, and Architecture TimingDB-to-OpenSTA translation are pending."
    },
    {
      "id": "default-open-fpga-routing",
      "status": "pending",
      "reason": "The default VTR architecture carries open routing parameters, but EmuFlow does not yet construct the exact routing-resource graph or integrate source-built VPR after OpenPARF placement. OpenPARF's experimental router subtree remains disabled because it requires proprietary GUROBI."
    },
    {
      "id": "open-ultrascale-plus-bitstream",
      "status": "out-of-scope-until-viable",
      "reason": "Vivado bitstream generation is optional proprietary sign-off and cannot count as completion of the source-complete path."
    }
  ],
  "optional_external_validation": [
    {
      "tool": "RapidWright standalone distribution",
      "uses": [
        "physical-region sidecar generation",
        "architecture comparison"
      ],
      "counts_as_open_flow_implementation": false
    },
    {
      "tool": "Vivado",
      "uses": [
        "architecture comparison",
        "timing comparison",
        "route and DRC comparison",
        "bitstream generation"
      ],
      "counts_as_open_flow_implementation": false
    }
  ]
}
